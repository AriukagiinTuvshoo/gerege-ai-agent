# STAGING ENVIRONMENT TEMPLATE — Gerege AI Agent
#
# Copy to `.env` next to docker-compose.staging.yml, then `chmod 600 .env`.
# This file is an EXAMPLE. Every value is a placeholder.
#
# THE RULE: staging must not share a single credential with production. Not the database
# password, not the admin password, not the Gemini key, not the Telegram token, not the
# QPay merchant. If a staging leak can reach production data or send real messages,
# staging is not a test environment — it is production with a different hostname.
#
# Generate every secret yourself:
#   openssl rand -base64 24    (passwords)
#   openssl rand -hex 32       (webhook secrets)

# ----------------------------------------------------------------- runtime
ENV=production
# `production` is correct for staging too: this is a production-shaped stack, and the
# fail-closed startup checks (secrets, Redis, CORS, least-privilege) should fire here
# exactly as they will in production. If staging runs with ENV=development, you are
# testing a different program.
STRICT_SECURITY=1
REQUIRE_LEAST_PRIVILEGE=1
WEBHOOK_FAIL_CLOSED=1
DISABLE_INLINE_SCHEDULER=1

# ----------------------------------------------------------------- TLS / proxy
# The real hostname. Caddy obtains a certificate for exactly this name, so it must
# resolve to the staging host BEFORE first start.
STAGING_DOMAIN=staging.example.mn
ACME_EMAIL=ops@example.mn

# Comma-separated origins. Must include the scheme.
ALLOWED_ORIGINS=https://staging.example.mn

# The subnet the Caddy container gets an address in. REQUIRED: the application only
# honours X-Forwarded-Proto from these peers, so a wrong value makes generated payment
# callbacks plaintext http://. Find the compose network with:
#   docker network inspect gerege-staging_default --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
TRUSTED_PROXIES=172.20.0.0/16

# ----------------------------------------------------------------- database
# Staging database name must differ from production so a shared host cannot collide.
POSTGRES_DB=gerege_staging
POSTGRES_USER=gerege
POSTGRES_PASSWORD=

# Two-plane roles (E-05). The app role owns nothing and cannot DDL.
POSTGRES_OWNER_USER=gerege_owner
POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_USER=gerege_app
POSTGRES_APP_PASSWORD=

# ----------------------------------------------------------------- connection budget
# Phase 36. 2 API processes x (5+5) + worker (2+2) + migrate (2+1) = 27 of 97 usable.
PG_MAX_CONNECTIONS=100
PG_SUPERUSER_RESERVED=3
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10
WORKER_DB_POOL_SIZE=2
WORKER_DB_MAX_OVERFLOW=2
UVICORN_WORKERS=2

# ----------------------------------------------------------------- auth
ADMIN_PASSWORD=
E02_ACCOUNT_KEY_SECRET=

# ----------------------------------------------------------------- redis
REDIS_URL=redis://redis:6379/0

# ----------------------------------------------------------------- integrations
# Use sandbox / test credentials ONLY. Leave blank to run with the integration disabled,
# which is a valid staging configuration: the app degrades instead of crashing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# A SEPARATE bot from the production bot. Never point staging at the live bot or a test
# message reaches real customers.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# A separate Meta app in development mode, so webhooks only reach test recipients.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=

# QPay SANDBOX only. Never put live merchant credentials in a staging file.
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn

# ----------------------------------------------------------------- backups
BACKUP_ENCRYPTION=on
# Path on the HOST to the key file (mounted read-only into `maintenance`).
#
# Phase 39 (F-39-F): this was spelled BACKUP_KEY_FILE, which no code path reads. The
# only name the backup plane reads is BACKUP_ENCRYPTION_KEY_FILE (core/backup_policy.py,
# core/backup_automation.py, core/backup_service.py, core/backup_archive.py). With
# BACKUP_ENCRYPTION=on and the variable unset, every hourly backup is REFUSED with
# ENCRYPTION_KEY_MISSING and exits 15 — measured, not inferred. An operator who copied
# this template believed a key was configured. Production's template and .env.example
# always used the correct name; only the staging template drifted.
BACKUP_ENCRYPTION_KEY_FILE=./secrets/backup.key
BACKUP_RETENTION_DAYS=7
BACKUP_MIN_KEEP=3
BACKUP_MAX_AGE_HOURS=36
# Offsite is optional in staging but should be configured at least once to prove the path.
BACKUP_OFFSITE_URL=
BACKUP_OFFSITE_ACCESS_KEY=
BACKUP_OFFSITE_SECRET_KEY=
BACKUP_OFFSITE_REGION=
BACKUP_ALERT_WEBHOOK=

# ----------------------------------------------------------------- health
# Rows the deep health summary is willing to count. /api/live and /api/ready do not use it.
HEALTH_SUMMARY_SCAN_LIMIT=1000
