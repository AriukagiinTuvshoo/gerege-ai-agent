# Gerege backup — one run. Invoked by gerege-backup.timer.
#
# NOT INSTALLED by this repository. Copy to /etc/systemd/system/, enable the timer,
# and verify with `systemctl list-timers`. See docs/operations/BACKUP_AUTOMATION.md.
#
# The owner credential lives in an EnvironmentFile with mode 0600, owned by root.
# It is never placed in this unit file, so it never appears in `systemctl cat`.
[Unit]
Description=Gerege CRM database backup (encrypted, verified, retained)
Documentation=file:///app/docs/operations/BACKUP_AUTOMATION.md
After=docker.service
Requires=docker.service
# `OnFailure` is a [Unit] directive, not a [Service] one. Placing it under [Service] makes
# systemd log "Unknown key" and silently ignore it - verified with `systemd-analyze verify`.
OnFailure=gerege-backup-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/gerege
EnvironmentFile=/etc/gerege/backup.env
# Distinct exit codes are passed through unchanged (10 backup, 11 crypto, 12 integrity,
# 13 credential, 14 offsite, 15 not configured, 16 locked, 18 timeout) so OnFailure
# handlers and alerting can distinguish them. 17 is reserved for `maintenance.py legacy`
# reporting plaintext on disk, which is a different operator action entirely.
#
# Phase 37: `OnFailure=` is set because without it a failed backup is silent. The distinct
# exit codes only help if something is watching, and a `Type=oneshot` unit that exits 10
# leaves no trace an operator would notice - `systemctl status` shows "failed" only if
# somebody looks. This unit therefore notifies `gerege-backup-alert@%n.service`, a template
# the operator instantiates on the host. If that unit does not exist, systemd logs a
# warning and *still records the failure*, so this cannot make things worse.
#
# Install the notifier once per host (see docs/operations/BACKUP_AUTOMATION.md section
# "Alerting"), for example:
#
#   # /etc/systemd/system/gerege-backup-alert@.service
#   [Unit]
#   Description=Notify that %i failed
#   [Service]
#   Type=oneshot
#   # Replace with your paging/chat hook; the exit code is in $EXIT_CODE metadata,
#   # so read it with `systemctl show -p ExecMainStatus %i`.
#   ExecStart=/usr/local/bin/gerege-notify-failure %i
#
# Monitoring the absence of success is stronger than monitoring failure, and the doc says
# so. OnFailure alone does not catch "the timer was never enabled".
ExecStart=/usr/bin/docker compose -f docker-compose.prod.yml run --rm \
    --no-deps maintenance python scripts/maintenance.py backup-run --label scheduled
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
