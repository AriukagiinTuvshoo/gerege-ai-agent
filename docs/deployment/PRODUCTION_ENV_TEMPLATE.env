# PRODUCTION ENVIRONMENT TEMPLATE — Gerege AI Agent
#
# Placeholders only. Never commit real values. Every value below was derived from
# docker-compose.prod.yml and by reading `os.getenv` call sites in the application.
# Nothing here has been deployed; this file is an audit deliverable.
#
# Copy to `.env` on the target host, chmod 600, and fill in. `.env` is in .dockerignore
# and .gitignore, so it is never baked into an image layer or committed.

# ---------------------------------------------------------------- runtime mode
# Required. `production` enables: strict security, fail-closed startup checks,
# HSTS, secure cookies, and refusal to run with a per-process rate limiter.
ENV=production
STRICT_SECURITY=1
REQUIRE_LEAST_PRIVILEGE=1
WEBHOOK_FAIL_CLOSED=1
# The API must not run the scheduler when a dedicated worker exists (see compose).
DISABLE_INLINE_SCHEDULER=1

# ---------------------------------------------------------------- database
# Bootstrap superuser — creates the cluster. NOT a runtime credential.
POSTGRES_USER=gerege
POSTGRES_PASSWORD=<generate: openssl rand -base64 24>
POSTGRES_DB=gerege_crm

# Two-plane credentials (E-05). The app role owns nothing and cannot DDL.
POSTGRES_OWNER_USER=gerege_owner
POSTGRES_OWNER_PASSWORD=<generate: openssl rand -base64 24>
POSTGRES_APP_USER=gerege_app
POSTGRES_APP_PASSWORD=<generate: openssl rand -base64 24>

# Maintenance-only DSN (backup/restore). Never given to web or worker.
DATABASE_OWNER_URL=postgresql://gerege_owner:<password>@db:5432/gerege_crm

# Connection pool. DEFAULTS ARE A CAPACITY RISK: 2 uvicorn workers x (10+20) = 60,
# plus 30 for the worker = 90, against PostgreSQL default max_connections=100.
# See docs/audit/PHASE_35_DEPLOYMENT_READINESS.md §3. Lower these or raise
# max_connections before launch.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=300000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=10000

# ---------------------------------------------------------------- redis
# Required in production; startup fails closed without it.
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------- auth / crypto
# Admin login. Required; compose fails at `up` if unset.
ADMIN_PASSWORD=<generate: openssl rand -base64 24>
# Keyed HMAC for account-level failed-login counters. Required, min 32 chars.
E02_ACCOUNT_KEY_SECRET=<generate: openssl rand -base64 32>

# ---------------------------------------------------------------- CORS
# Required in production; the app refuses to start if empty.
# Comma-separated, scheme included, no trailing slash.
ALLOWED_ORIGINS=https://app.<your-domain>

# ---------------------------------------------------------------- TLS / reverse proxy
# Phase 38. Production now runs a Caddy `proxy` in front of `web`; the application port
# is no longer published. These three are REQUIRED — `docker compose up` refuses to start
# without them rather than coming up over plaintext.

# The real hostname Caddy obtains a certificate for. DNS A/AAAA must already point at this
# host, and ports 80/443 must be reachable from the internet. There is no default.
PRODUCTION_DOMAIN=app.<your-domain>

# Let's Encrypt account address, used for certificate-expiry warnings.
ACME_EMAIL=ops@<your-domain>

# The proxy's address/CIDR on the compose network. The app only honours X-Forwarded-Proto
# from these peers; with an empty value it would mint http:// payment callback URLs even
# though clients arrive over https. The compose default bridge is 172.16.0.0/12 — narrow it
# to the actual proxy subnet once you know it. NEVER 0.0.0.0/0: that would let any client
# on the network forge its own scheme.
TRUSTED_PROXIES=172.16.0.0/12

# ---------------------------------------------------------------- AI provider
# Optional. Without it the agent degrades to a deterministic fallback (HTTP 200,
# model="fallback"). Not a startup blocker.
GEMINI_API_KEY=<from Google AI Studio>
GEMINI_MODEL=gemini-3.5-flash-lite
# Alternative provider (unused unless configured).
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# ---------------------------------------------------------------- Meta / Instagram
META_APP_SECRET=<from Meta app dashboard>
META_VERIFY_TOKEN=<generate: openssl rand -hex 16>
META_PAGE_ACCESS_TOKEN=<per-page token from Meta>

# ---------------------------------------------------------------- Telegram
TELEGRAM_WEBHOOK_SECRET=<generate: openssl rand -hex 32>
TELEGRAM_BOT_TOKEN=<from @BotFather>
TELEGRAM_MANAGER_CHAT_ID=<owner chat id>

# ---------------------------------------------------------------- QPay
# Provider verification is unconditional and fail-closed; there is no "strict"
# switch to set. Without credentials, callbacks return 400 and no payment settles.
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
QPAY_BASE_URL=https://merchant.qpay.mn

# ---------------------------------------------------------------- backups
# Encryption is ON by default; the run fails closed in production without a key.
BACKUP_ENCRYPTION=on
BACKUP_ENCRYPTION_KEY_FILE=/run/secrets/backup.key
BACKUP_RETENTION_DAYS=14
BACKUP_MIN_KEEP=7
BACKUP_MAX_AGE_HOURS=36
# Offsite: prefer S3-compatible over a second local mount.
BACKUP_OFFSITE_URL=
BACKUP_OFFSITE_ACCESS_KEY=
BACKUP_OFFSITE_SECRET_KEY=
BACKUP_OFFSITE_REGION=
BACKUP_ALERT_WEBHOOK=

# ---------------------------------------------------------------- not required
# GOOGLE_SHEETS_CREDENTIALS_JSON was previously listed here. It is NOT read by any
# code: Sheets integration fetches public CSV exports by URL. Setting it has no
# effect. Removed to stop operators debugging a variable that does nothing.
