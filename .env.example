# =============================================================================
#  GEREGE AI AGENT — Жишээ орчны тохиргоо
#  Энэ файлыг `.env` болгон хуулж, утгуудыг бөглөнө үү. `git`-д БҮҮ commit хийнэ.
#  Бүх нууц утгыг placeholder хэлбэрээр л үлдээсэн — бодит түлхүүр бичихгүй.
# =============================================================================

# --- AI Provider -------------------------------------------------------------
# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- CORS (SEC-01/B-02) ------------------------------------------------------
# ЗӨВХӨН эдгээр origin-оос browser хүсэлт зөвшөөрөгдөнө (таслалаар тусгаарлана).
# Production-д ЗААВАЛ тохируулна. `*` хэзээ ч зөвшөөрөгдөхгүй, ялангуяа
# allow_credentials=True үед. Хоосон бол production-д fail-closed (`APP_ORIGIN`).
#   Жишээ: https://app.gerege.mn,https://admin.gerege.mn
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Production-д ALLOWED_ORIGINS тохируулаагүй үед ашиглагдах өөрийн origin
APP_ORIGIN=

# --- Trusted proxy (E-02 Phase 3) -------------------------------------------
# Rate limit нь client-ийг ХЭН гэдгийг энэ жагсаалтаар шийднэ. Зөвхөн энэ апп-ын
# ӨМНӨ таны хяналтад байдаг proxy/load balancer ажиллаж байгаа үед л бөглөнө.
#
#   ХООСОН БОЛ ЯМАР Ч forwarded header-д ИТГЭХГҮЙ (аюулгүй default).
#   IPv4, IPv6, CIDR дэмжинэ. Таслалаар тусгаарлана.
#   `*`, `0.0.0.0/0`, `::/0` хориотой — бүх дэлхийд итгэх нь хамгаалалтыг унтраана.
#
# ⚠ Зөвхөн proxy-гийн IP-г бичнэ, client-ийн биш. Жагсаалт буруу бол бүх хэрэглэгч
#   нэг identity-д нийлж, rate limit бүх хэрэглэгчийг хамт блоклоно.
#   Жишээ: TRUSTED_PROXIES=10.0.0.0/8,2001:db8::/32
TRUSTED_PROXIES=

# --- E-02 Phase 4: account-level failed-login protection ---------------------
# Нэг account руу олон IP-ээс хийх нууц үг таах оролдлогыг хязгаарлана.
#
#   PRODUCTION (ENV=production эсвэл STRICT_SECURITY=1) ДЭЭР ХООСОН БОЛ АПП
#   АСАХГҮЙ — startup дээр RuntimeError шидэж, процесс зогсоно. Учир нь чимээгүй
#   унтарсан хамгаалалт байхгүйгээс ч дор: байгаа гэж итгэдэг.
#   DEVELOPMENT/TEST горимд хоосон бол account throttle унтарна (WARNING лог),
#   unkeyed hash руу чимээгүй шилжихгүй.
#
#   Хамгийн бага урт: 32 тэмдэгт. Богино утга нь key биш, нууц үг.
#
#   ЯАГААД keyed HMAC вэ: rate-limit key нь Redis-д хадгалагдана. Хэрэглэгчийн нэр
#   бага энтропитой (жишээ: `<brand>-mn`), тиймээс plain SHA-256 нь dictionary-ээр
#   буцаагдана. keyed BLAKE2b нь secret-гүйгээр offline таагдахгүй.
#
#   ⚠ ДАХИН АШИГЛАХГҮЙ: META_APP_SECRET / TELEGRAM_WEBHOOK_SECRET / GEMINI_API_KEY.
#     Эдгээр нь vendor-ийн хуваарьтай rotate болдог, гуравдагч талтай хуваалцдаг —
#     rotate болох бүрд бүх account counter чимээгүй reset болно.
#
#   Үүсгэх:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#   Хадгалах: .env-д биш, secret manager / орчны хувьсагчаар дамжуулна. Git-д БҮҮ.
#   Rotate:  хуучин counter-ууд orphan болж, хязгаарлалт reset болно (window дотор
#            өөрөө эдгэрнэ; хэнийг ч lockout-д оруулахгүй). Restart-аар хүчин төгөлдөр.
#   Лог:     утга нь ЯМАР Ч лог, алдааны мессеж, API хариу, frontend bundle-д гарахгүй.
E02_ACCOUNT_KEY_SECRET=

# --- Meta (Facebook Page & Instagram Direct) ---------------------------------
# Meta Developer App → Webhook Verify Token
META_VERIFY_TOKEN=
# Meta App Secret — webhook `X-Hub-Signature-256` шалгахад ЗААВАЛ хэрэгтэй
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v22.0

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# setWebhook-ийн `secret_token` — webhook хүсэлтийг баталгаажуулна
TELEGRAM_WEBHOOK_SECRET=

# --- ManyChat ---------------------------------------------------------------
MANYCHAT_WEBHOOK_SECRET=

# --- QPay v2 (Монгол төлбөрийн гарц) -----------------------------------------
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=

# --- Өгөгдлийн сан / Redis ---------------------------------------------------
# Production: postgresql+psycopg2://user:password@host:5432/dbname
# Хоосон бол локал SQLite (leads.db) — production-д БОЛОХГҮЙ.
# E-05: the RUNTIME credential. In production this must be `gerege_app`, never the
# bootstrap superuser — the app refuses to start otherwise (ENV=production or
# STRICT_SECURITY=1). Provision it with `python scripts/provision_roles.py --apply`.
# Development/SQLite: leave empty as before; the check is a no-op on SQLite.
DATABASE_URL=
# E-05: MAINTENANCE credential, owner plane only. Used by `scripts/maintenance.py`
# (backup/restore) and by `scripts/provision_roles.py`. Never give this to web/worker.
DATABASE_OWNER_URL=
# E-05: passwords consumed by provisioning and by docker-compose.prod.yml.
# Generate with `provision_roles.py --apply` (printed once) or openssl rand -base64 24.
# Blank is fine locally: SQLite has no roles and provisioning reports them missing.
POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_PASSWORD=
# E-02 Phase 6 (R11): production-д ЗААВАЛ. Rate-limit counter нь бүх worker-т нэг байх ёстой;
# хоосон бол per-process memory fallback руу шилжиж, бодит лимит нь `limit x workers` болно.
# Production-д хоосон/хүрэхгүй bol startup нь RateLimitStoreUnavailable-аар зогсоно (эхлэхгүй).
# Development/test-д хоосон байж болно — memory fallback (limit зөвхөн нэг process-д).
REDIS_URL=redis://127.0.0.1:6379/0

# --- Аюулгүй байдал ----------------------------------------------------------
# Супер админы нууц үг. Production-д заавал өөрчилнө.
# Тохируулаагүй бол production/strict горимд admin нэвтрэлт fail-closed (403).
ADMIN_PASSWORD=
ENV=development
STRICT_SECURITY=0

# Webhook гарын үсэг байхгүй бол хүсэлтийг хориглоно (production-д автоматаар 1)
WEBHOOK_FAIL_CLOSED=1

# Production-д `?token=` query-параметрээр нэвтрэхийг зөвшөөрөх эсэх (default: хориглоно)
ALLOW_QUERY_TOKEN=0
# Dev/test-д query token-ыг бүрэн хаах
DISALLOW_QUERY_TOKEN=0

# --- Төлбөрийн симулятор (зөвхөн dev/test) -----------------------------------
# Production-д ямар ч нөхцөлд ажиллахгүй (403).
ENABLE_PAYMENT_SIMULATOR=0
# QPay callback-ыг баталгаажуулахгүйгээр mock болгох (зөвхөн тест; production-д 403)
ALLOW_MOCK_QPAY_CALLBACK=0

# --- Сервэр -----------------------------------------------------------------
PORT=8000
# Inline scheduler-ыг (executive report) унтраах — олон instance үед 1 болгоно
DISABLE_INLINE_SCHEDULER=0

# --- Google Sheets (сонголтоор) ----------------------------------------------
GOOGLE_SHEETS_CREDENTIALS_JSON=
