# Google Gemini API түлхүүр (https://aistudio.google.com/app/apikey хаягаас үнэгүй авна)
GEMINI_API_KEY=

# Gemini загвар
GEMINI_MODEL=gemini-2.5-flash

# Meta Webhook тохиргоо (Facebook Page & Instagram Direct)
# Энэ нууц үгийг Meta Developer App дээрээ Webhook холбохдоо оруулна
META_VERIFY_TOKEN=agent_verify_secret_token_123

# Facebook Page Access Token (Мессежинд автоматаар хариу өгөхөд ашиглана)
META_PAGE_ACCESS_TOKEN=

# Telegram Bot Token (хэрэв Telegram-тай холбох бол @BotFather-оос авна)
TELEGRAM_BOT_TOKEN=

# Серверийн порт
PORT=8000
